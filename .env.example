# Optional local API protection; do not use a real key in this file.
GOALPILOT_TOKEN=
# Set all three to enable one explicitly consented model call per video run:
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Optional database path outside the repository:
GOALPILOT_DB=

# Optional SEO lab measurements; additionally requires saved project opt-in:
PAGESPEED_API_KEY=

# Creator speech provider: OpenAI-compatible /audio/speech endpoint.
# Choose currently supported model/stock voice; no default paid calls.
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_API_KEY=
# Optional, only for speech models that support instructions:
TTS_INSTRUCTIONS=
